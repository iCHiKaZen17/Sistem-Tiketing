# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Signed dashboard session (generate at least 32 random characters)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JOB_SECRET=replace-with-a-separate-long-random-secret
APP_BASE_URL=https://ticketing.example.com

# Upstash Redis: rate limit, session revocation, cache, dan job lock
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Upstash QStash: scheduler dan retry job
QSTASH_TOKEN=YOUR_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=YOUR_QSTASH_CURRENT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=YOUR_QSTASH_NEXT_SIGNING_KEY
# Aktifkan hanya setelah outbound API WhatsApp tersedia.
ENABLE_WHATSAPP_OUTBOX_SCHEDULE=false
ENABLE_WHATSAPP_MEDIA_SCHEDULE=false

# Office WhatsApp gateway (default provider)
WHATSAPP_WEBHOOK_PROVIDER=office
WHATSAPP_OFFICE_WEBHOOK_SECRET=replace-with-office-shared-hmac-secret
WHATSAPP_OFFICE_SIGNATURE_HEADER=x-webhook-signature
# Optional: when set, ticket confirmations are POSTed to this office endpoint.
WHATSAPP_OFFICE_SEND_URL=
WHATSAPP_OFFICE_API_TOKEN=
# Outbound multipart fields default to: to, file, caption.
WHATSAPP_OFFICE_ATTACHMENT_SEND_URL=
WHATSAPP_OFFICE_ATTACHMENT_API_TOKEN=
# URL template must contain {media_id}, for example https://gateway.example/media/{media_id}.
WHATSAPP_OFFICE_MEDIA_DOWNLOAD_URL=
WHATSAPP_OFFICE_MEDIA_API_TOKEN=

# Optional Meta-compatible handshake/adapter
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
