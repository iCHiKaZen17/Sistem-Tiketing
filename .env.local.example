# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JOB_SECRET=replace-with-a-separate-long-random-secret
APP_BASE_URL=https://your-deployment.example.com

# Upstash Redis: rate limit, session revocation, cache, dan job lock
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Upstash QStash Configuration (for async message processor & job queue)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
# Aktifkan hanya setelah outbound API WhatsApp tersedia.
ENABLE_WHATSAPP_OUTBOX_SCHEDULE=false

# WhatsApp Meta Cloud API Configuration
WHATSAPP_WEBHOOK_PROVIDER=office
WHATSAPP_OFFICE_WEBHOOK_SECRET=your-office-hmac-secret
WHATSAPP_OFFICE_SIGNATURE_HEADER=x-webhook-signature
WHATSAPP_OFFICE_SEND_URL=
WHATSAPP_OFFICE_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_API_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
